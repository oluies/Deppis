# roborev snapshots
/.roborev/

# JVM / Scala / sbt
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
*.class
.DS_Store

# npm deps for the Scala.js bundle
node_modules/

# Generated browser bundle of the Scala.js engine (build via scripts/build-web-bundle.sh)
clients/flutter/web/protocol-engine.js

# Gatling benchmark output (reports, per-run logs, staged classpath)
bench/target/

# Python bytecode cache. scripts/test_check_scalapb_grpc_pin.py loads the gate it tests via
# importlib (its filename has dashes, so a plain import will not do), which writes
# scripts/__pycache__/. The toolchain-gate tests next door drive their script by subprocess and
# leave nothing behind; this one cannot, so ignore the cache rather than let it show up as
# untracked noise in every working tree that has run the hygiene checks.
__pycache__/
*.pyc
